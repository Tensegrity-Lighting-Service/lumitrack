{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lumitrack",
  "version": "0.3.0-beta.1",
  "identifier": "eu.lumitrack.editor",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFRUE1MzU2OTRCN0YzMTkKUldRWjg3ZVVWbFBxam5qN2tqYTRMK2NXYjhQekMxQ01xYWtISDIyOG9KUmdoU2FEQVlPazNIRFMK",
      "endpoints": [
        "https://github.com/Tensegrity-Lighting-Service/lumitrack/releases/latest/download/latest.json"
      ]
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumitrack",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Lumitrack",
        "url": "/splashscreen.html",
        "width": 420,
        "height": 240,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/lumitrack-sidecar"],
    "fileAssociations": [
      {
        "ext": ["lumitrack"],
        "name": "Lumitrack",
        "description": "Projet Lumitrack",
        "mimeType": "application/x-lumitrack"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
